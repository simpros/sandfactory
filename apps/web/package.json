{
  "name": "@sandfactory/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun ./node_modules/vite/bin/vite.js dev",
    "build": "bun --bun ./node_modules/vite/bin/vite.js build",
    "preview": "bun --bun ./node_modules/vite/bin/vite.js preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun test --conditions browser",
    "test:e2e": "bun --bun --env-file=.env.e2e playwright test"
  },
  "devDependencies": {
    "@sandfactory/auth": "workspace:*",
    "@sandfactory/db": "workspace:*",
    "@sandfactory/eslint-config": "workspace:*",
    "@sandfactory/logging": "workspace:*",
    "@sandfactory/tailwind-config": "workspace:*",
    "@sandfactory/ui": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-node": "5.5.4",
    "@sveltejs/kit": "2.59.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.3.10",
    "better-auth": "1.4.18",
    "bits-ui": "^2.16.2",
    "drizzle-orm": "1.0.0-rc.2",
    "runed": "^0.37.1",
    "svelte": "5.55.5",
    "svelte-check": "4.3.6",
    "tailwindcss": "^4.0.0",
    "typescript": "5.9.3",
    "valibot": "^1.2.0",
    "vite": "7.3.1"
  },
  "dependencies": {}
}
